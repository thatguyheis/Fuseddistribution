{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fused-client-instructions",
  "account_id": "904933a9a5d8c62b3b9506cb697ce080",
  "main": "./src/worker.js",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fused-client-instructions",
      "database_id": "f139f6d7-0e28-4267-918d-9033e25ba041",
      "migrations_dir": "./migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "REELS_KV",
      "id": "20cd4e65773842deb15b8a12356c8e96"
    }
  ],
  "vars": {
    "C1994_WORKFLOW_SHA256": "f30aba17ca82f9083c7f07e31f8177a15357740023f77481baee5925a7caeafd",
    "DAILY_RUN_LIMIT": "20",
    "MEDIA_BASE_URL": "https://fused-reel-media.luxraycoco.workers.dev"
  },
  "preview_urls": false
}
