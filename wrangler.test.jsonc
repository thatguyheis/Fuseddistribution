{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fuseddistribution",
  "account_id": "904933a9a5d8c62b3b9506cb697ce080",
  "main": "src/worker.js",
  "compatibility_date": "2026-04-15",
  "observability": {
    "enabled": true
  },
  "vars": {
    "MAILERLITE_API_KEY": "test-value",
    "METAL_PRICE_API_KEY": "test-metal-key"
  },
  "assets": {
    "directory": "./public/reserve",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "SPOT_KV",
      "id": "test-spot-kv"
    },
    {
      "binding": "REELS_KV",
      "id": "test-reels-kv"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SUBMISSION_RATE_LIMITER",
        "class_name": "SubmissionRateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SubmissionRateLimiter"]
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
