.DS_Store
/node_modules/
cloudflare-upload/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example
!video/.env.cron.example

# photo workflow local/source assets
public/photos/.DS_Store
public/photos/uploads/*
!public/photos/uploads/.gitkeep
public/photos/originals/*
!public/photos/originals/.gitkeep
public/photos/derived/social/*
!public/photos/derived/social/.gitkeep
public/photos/derived/marketplace/*
!public/photos/derived/marketplace/.gitkeep

# Rendered video files — too large for GitHub
video/out/**/*.mp4
public/reels/**/*.mp4
public/reels-x/**/*.mp4

# Reel media cache. These files are downloaded or regenerated locally from
# media manifests and must not become multi-gigabyte Git history.
video/public/photos/
video/public/videos/

# Local posting/render staging and transient diagnostics
.facebook-reels-staging/
ffmpeg2pass-*.log
ffmpeg2pass-*.log.*
scripts/daily-blog-reel.log
public/blog/*/.qa-brain.log
**/__pycache__/
*.pyc
.superpowers/
video/.superpowers/

# Local social posting handoff files include machine-specific asset paths
public/blog/*/posting-pack.json
public/blog/*/posting-pack.md
.buffer-media-urls.json
.buffer-x-media-urls.json
.buffer-youtube-queue.json
.buffer-youtube-queue*.json
.buffer-x-queue.json
.buffer-x-queue*.json
.buffer-instagram-queue.json
.buffer-instagram-queue*.json
.buffer-youtube-scheduled.json
.buffer-x-scheduled.json
.buffer-instagram-scheduled.json
.facebook-reels-batch.json
.facebook-reels-batch.md
.facebook-reels-batch*.json
.facebook-reels-batch*.md
.facebook-reels-posted.json

# Local quarantine for QA-failed generated blog artifacts
.workflow-blocked/
.workflow-state/

# Local Claude/Codex worktrees can contain copied env files
.claude/worktrees/

# Local AI/audio generation tools, model caches, and unapproved candidates
.local-tools/
.model-cache/
video/music-candidates/
video/local/generated-backgrounds/
