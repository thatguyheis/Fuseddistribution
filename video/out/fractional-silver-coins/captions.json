    {
      "text": "ter, gifting, or denomination",
      "startSec": 14.69,
      "endSec": 16.09
    },
    {
      "text": "flexibility.",
      "startSec": 16.09,
      "endSec": 16.8
    },
    {
      "text": "Not as a starting point.",
      "startSec": 16.8,
      "endSec": 18.3
    }
  ],
  "8": [
    {
      "text": "When you do buy a fractional, stick to",
      "startSec": 0,
      "endSec": 1.76
    },
    {
      "text": "recognize government events.",
      "startSec": 1.76,
      "endSec": 3.36
    },
    {
      "text": "American silver eagles, Canadian maple",
      "startSec": 3.36,
      "endSec": 5.16
    },
    {
      "text": "leaves, and Britannias are known",
      "startSec": 5.16,
      "endSec": 6.88
    },
    {
      "text": "worldwide.",
      "startSec": 6.88,
      "endSec": 7.52
    },
    {
      "text": "They sell the easiest when you need to",
