      "startSec": 9.76,
      "endSec": 13.32
    },
    {
      "text": "This is a real structural advantage",
      "startSec": 13.32,
      "endSec": 15.13
    },
    {
      "text": "over SLV.",
      "startSec": 15.13,
      "endSec": 15.8
    },
    {
