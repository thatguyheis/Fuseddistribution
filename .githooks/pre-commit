#!/bin/sh
set -eu

node scripts/worktree-hygiene.mjs --staged --strict --write-report

GITLEAKS="$(command -v gitleaks || true)"
if [ -n "$GITLEAKS" ]; then
  "$GITLEAKS" git --staged --config .gitleaks.toml --no-banner --redact
else
  echo "BLOCKED: gitleaks is required for commits. Install it with Homebrew." >&2
  exit 1
fi
