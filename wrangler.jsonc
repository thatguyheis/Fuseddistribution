{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fuseddistribution",
  "account_id": "904933a9a5d8c62b3b9506cb697ce080",
  "main": "src/worker.js",
  "compatibility_date": "2026-04-15",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SUBMISSION_RATE_LIMITER",
        "class_name": "SubmissionRateLimiter"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "SPOT_KV",
      "id": "68478afd1bca48a88ecf25ea907a0bc8"
    }
  ],
  "triggers": {
    "crons": ["5 0 * * *"]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SubmissionRateLimiter"]
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
